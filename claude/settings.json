{
  "permissions": {
    "allow": [],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "fw@fourthwall": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "fourthwall": {
      "source": {
        "source": "git",
        "url": "git@gitlab.com:popshopdev/ai/skills.git"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true
}
