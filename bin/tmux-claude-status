#!/usr/bin/env bash
#
# Claude Code lifecycle hook -> stores running status as tmux options that
# choose-tree reads. Sets both window and session options so the indicator is
# visible regardless of how the tree is expanded.
#
# Status options written:
#   @claude_status         icon + label + elapsed, padded to fixed-width
#                          columns so choose-tree rows align (~20 cells:
#                          icon(1) + space + label(8) + space + (elapsed(7)))
#   @claude_summary        1-line context: user prompt while working,
#                          last assistant reply on Stop / Notification
#   @claude_started_at     unix ts: set on UserPromptSubmit, cleared on Stop
#   @claude_waiting_since  unix ts: set on Notification, cleared on next prompt
#
# Live elapsed times and age-based color tiers are recomputed by
# tmux-claude-refresh-status, which the `prefix + s` binding calls right
# before opening choose-tree.
#
# Invoked by Claude Code hooks with one of:
#   UserPromptSubmit | PreToolUse | Stop | Notification

set -u

event="${1:-}"

# Capture the JSON payload Claude sends on stdin (different shape per event).
input="$(cat 2>/dev/null || true)"

[ -n "${TMUX:-}" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0

read -r session window <<<"$(tmux display-message -p -t "$TMUX_PANE" '#{session_name} #{window_id}' 2>/dev/null)"
[ -n "$session" ] && [ -n "$window" ] || exit 0

format_elapsed() {
    local elapsed="$1"
    if [ "$elapsed" -ge 3600 ]; then
        printf '%dh %dm' $((elapsed / 3600)) $(((elapsed % 3600) / 60))
    else
        printf '%02d:%02d' $((elapsed / 60)) $((elapsed % 60))
    fi
}

# Build a fixed-width styled status string. Padding goes AFTER the closing
# paren (not inside the elapsed slot) so we get e.g. "⏸ waiting! (01:23)   "
# instead of "⏸ waiting! (01:23  )" — natural trailing whitespace, not weird
# gaps inside the parens. ${#content} counts codepoints, not display cells —
# fine here because every status uses exactly one icon, so any cell-width skew
# is identical across rows.
build_status() {
    local style="$1" icon="$2" label="$3" elapsed_secs="$4"
    local elapsed_fmt content pad
    elapsed_fmt=$(format_elapsed "$elapsed_secs")
    content="${icon} ${label} (${elapsed_fmt})"
    pad=$((22 - ${#content}))
    [ "$pad" -lt 0 ] && pad=0
    printf '#[%s]%s#[default]%*s' "$style" "$content" "$pad" ''
}

# Collapse whitespace, escape '#' for tmux format, truncate to fit a status row.
sanitize_summary() {
    printf '%s' "$1" | tr '\n\t' '  ' | tr -s ' ' | sed -E 's/^ +//; s/ +$//; s/#/##/g' | cut -c1-80
}

set_opt() {
    local key="$1" value="$2"
    tmux set-option -w -t "$window"  "$key" "$value" 2>/dev/null || true
    tmux set-option    -t "$session" "$key" "$value" 2>/dev/null || true
}

last_assistant_text() {
    local transcript
    transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)
    [ -n "$transcript" ] && [ -r "$transcript" ] || return 0
    tail -n 80 "$transcript" 2>/dev/null \
        | jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // empty' 2>/dev/null
}

case "$event" in
    UserPromptSubmit)
        started_at=$(date +%s)
        prompt=$(printf '%s' "$input" | jq -r '.prompt // empty' 2>/dev/null)
        set_opt "@claude_started_at"    "$started_at"
        set_opt "@claude_waiting_since" ""
        set_opt "@claude_status"        "$(build_status 'fg=yellow' '⚡' 'working' 0)"
        set_opt "@claude_summary"       "$(sanitize_summary "$prompt")"
        ;;
    PreToolUse)
        existing=$(tmux show-option -wqv -t "$window" "@claude_started_at" 2>/dev/null)
        if [ -n "$existing" ]; then
            elapsed=$(( $(date +%s) - existing ))
            set_opt "@claude_status" "$(build_status 'fg=yellow' '⚡' 'working' "$elapsed")"
        fi
        ;;
    Notification)
        set_opt "@claude_started_at"    ""
        set_opt "@claude_waiting_since" "$(date +%s)"
        # Just transitioned to waiting — strongest visual signal (reverse).
        # tmux-claude-refresh-status will downgrade the style as the wait ages.
        set_opt "@claude_status"        "$(build_status 'fg=red,bold,reverse' '⏸' 'waiting!' 0)"
        set_opt "@claude_summary"       "$(sanitize_summary "$(last_assistant_text)")"
        ;;
    Stop)
        existing=$(tmux show-option -wqv -t "$window" "@claude_started_at" 2>/dev/null)
        elapsed=0
        if [ -n "$existing" ]; then
            elapsed=$(( $(date +%s) - existing ))
        fi
        set_opt "@claude_started_at"    ""
        set_opt "@claude_waiting_since" ""
        set_opt "@claude_status"        "$(build_status 'fg=green,bold' '✅' 'done' "$elapsed")"
        set_opt "@claude_summary"       "$(sanitize_summary "$(last_assistant_text)")"
        ;;
esac
