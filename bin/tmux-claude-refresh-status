#!/usr/bin/env bash
#
# Recompute live elapsed time and age-based color tier on @claude_status for
# every claude window. Tmux's format strings have no "current time" variable,
# so we precompute the timer here and stamp it into the option right before
# choose-tree reads it.
#
# Color tiers for waiting (drives pre-attentive triage in the session list):
#   < 5 min    red,bold,reverse  ⏸ waiting!   — fresh, needs you now
#   < 1 hour   red,bold          ⏸ waiting!   — recent, still active
#   < 24 h     yellow            ⏸ waiting    — stale, probably drifted
#   24h–48h    colour240 (dim)   ⏸ waiting    — dying, likely forgotten
#                                              (darker than the prior colour244
#                                              so it visibly contrasts yellow)
#   >= 48 h    (cleared)                       — zombie; hooks never fired Stop
#
# Iterates windows (not sessions): tmux's session-format resolution walks
# through the session's active window for user options, so a stale window
# value would mask a freshly-written session value. We update both levels
# to match how tmux-claude-status writes them.
#
# Reads @claude_started_at (working) and @claude_waiting_since (waiting).
# Skips windows where neither is set (done / never-touched / not claude).

set -u

now=$(date +%s)

# Helpers write into REPLY instead of stdout so callers can use them
# without `$(...)` subshells (saves ~5-10ms per call; this script runs
# build_status once per claude window and that adds up).

format_elapsed() {
    local elapsed="$1"
    if [ "$elapsed" -ge 3600 ]; then
        printf -v REPLY '%dh %dm' $((elapsed / 3600)) $(((elapsed % 3600) / 60))
    else
        printf -v REPLY '%02d:%02d' $((elapsed / 60)) $((elapsed % 60))
    fi
}

build_status() {
    local style="$1" icon="$2" label="$3" elapsed_secs="$4"
    local content pad
    format_elapsed "$elapsed_secs"
    content="${icon} ${label} (${REPLY})"
    pad=$((22 - ${#content}))
    [ "$pad" -lt 0 ] && pad=0
    printf -v REPLY '#[%s]%s#[default]%*s' "$style" "$content" "$pad" ''
}

# Batch all set-option writes into ONE tmux invocation. Each tmux roundtrip
# costs ~15ms (client→server IPC), so iterating per-window with separate
# `tmux set-option` calls was the bulk of the latency before opening
# choose-tree / the fzf picker. tmux's command parser treats ";" as a command
# separator within a single argv list, so we accumulate one giant argv and
# dispatch it in one call.
cmds=()
queue_set() { cmds+=(set-option "$@" ";"); }

while IFS='|' read -r session window_id started_at waiting_since; do
    [ -n "$session" ] && [ -n "$window_id" ] || continue
    if [ -n "$started_at" ]; then
        elapsed=$((now - started_at))
        build_status 'fg=yellow' '⚡' 'working' "$elapsed"
    elif [ -n "$waiting_since" ]; then
        elapsed=$((now - waiting_since))
        if   [ "$elapsed" -ge 172800 ]; then
            # Zombie: clear window- and session-level state.
            queue_set -w -t "$window_id" "@claude_status"        ""
            queue_set -w -t "$window_id" "@claude_waiting_since" ""
            queue_set -w -t "$window_id" "@claude_summary"       ""
            queue_set    -t "$session"   "@claude_status"        ""
            queue_set    -t "$session"   "@claude_waiting_since" ""
            queue_set    -t "$session"   "@claude_summary"       ""
            continue
        elif [ "$elapsed" -lt 300 ];   then
            build_status 'fg=red,bold,reverse' '⏸' 'waiting!' "$elapsed"
        elif [ "$elapsed" -lt 3600 ];  then
            build_status 'fg=red,bold'         '⏸' 'waiting!' "$elapsed"
        elif [ "$elapsed" -lt 86400 ]; then
            build_status 'fg=yellow'           '⏸' 'waiting'  "$elapsed"
        else
            build_status 'fg=colour240'        '⏸' 'waiting'  "$elapsed"
        fi
    else
        continue
    fi
    queue_set -w -t "$window_id" "@claude_status" "$REPLY"
    queue_set    -t "$session"   "@claude_status" "$REPLY"
done < <(tmux list-windows -a -F '#{session_name}|#{window_id}|#{@claude_started_at}|#{@claude_waiting_since}' 2>/dev/null)

if (( ${#cmds[@]} > 0 )); then
    # Drop trailing ";" — tmux errors on an empty trailing command. Computed
    # index (not `unset 'cmds[-1]'`) for bash 3.2 compatibility, since tmux
    # popups on macOS may resolve `env bash` to /bin/bash (3.2) instead of
    # homebrew's 4+ build when PATH isn't passed through.
    last=$((${#cmds[@]} - 1))
    unset "cmds[$last]"
    tmux "${cmds[@]}" 2>/dev/null
fi
