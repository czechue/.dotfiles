#!/usr/bin/env bash
#
# Recompute live elapsed time on @claude_status for every claude window.
# Tmux's format strings have no "current time" variable, so we precompute
# the timer here and stamp it into the option right before choose-tree
# reads it.
#
# Iterates windows (not sessions): tmux's session-format resolution walks
# through the session's active window for user options, so a stale window
# value would mask a freshly-written session value. We update both levels
# to match how tmux-claude-status writes them.
#
# Reads @claude_started_at (working) and @claude_waiting_since (waiting).
# Skips windows where neither is set (done / never-touched / not claude).

set -u

now=$(date +%s)

format_elapsed() {
    local elapsed="$1"
    if [ "$elapsed" -ge 3600 ]; then
        printf '%dh %dm' $((elapsed / 3600)) $(((elapsed % 3600) / 60))
    else
        printf '%02d:%02d' $((elapsed / 60)) $((elapsed % 60))
    fi
}

while IFS='|' read -r session window_id started_at waiting_since; do
    [ -n "$session" ] && [ -n "$window_id" ] || continue
    if [ -n "$started_at" ]; then
        elapsed=$((now - started_at))
        status="#[fg=yellow]⚡ working#[default] ($(format_elapsed "$elapsed"))"
    elif [ -n "$waiting_since" ]; then
        elapsed=$((now - waiting_since))
        status="#[fg=red,bold]⏸ waiting!#[default] ($(format_elapsed "$elapsed"))"
    else
        continue
    fi
    tmux set-option -w -t "$window_id" "@claude_status" "$status" 2>/dev/null
    tmux set-option    -t "$session"   "@claude_status" "$status" 2>/dev/null
done < <(tmux list-windows -a -F '#{session_name}|#{window_id}|#{@claude_started_at}|#{@claude_waiting_since}' 2>/dev/null)
